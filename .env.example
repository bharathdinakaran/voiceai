PORT=8080
# Set to true to execute real API calls. If false, server blocks booking requests.
LIVE_BOOKING_ENABLED=true

# Provider base URLs (official partner endpoints or your gateway)
ZOMATO_BASE_URL=
OLA_BASE_URL=
UBER_BASE_URL=

# Provider auth tokens
ZOMATO_API_KEY=
OLA_API_KEY=
UBER_API_KEY=

# Optional callback/webhook for audit trail
BOOKING_AUDIT_WEBHOOK=

# AI4Bharat ASR voice layer
AI4BHARAT_ASR_URL=
AI4BHARAT_API_KEY=
